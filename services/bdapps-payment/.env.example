PAYMENT_MIN_AMOUNT_BDT=5.00
PAYMENT_MAX_AMOUNT_BDT=100.00
BDAPPS_BASE_URL=https://developer.bdapps.com
BDAPPS_APPLICATION_ID=APP_000000
BDAPPS_PASSWORD=replace-me
BDAPPS_APPLICATION_HASH=
BDAPPS_REQUEST_TIMEOUT_MS=15000
BDAPPS_CAAS_BALANCE_PATHS=/caas/get/balance,/caas/balance/query
BDAPPS_CAAS_PAYMENT_INSTRUMENTS_PATH=/caas/list/pi
